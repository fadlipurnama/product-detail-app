# Frontend environment variables
# Salin file ini menjadi .env.local lalu isi nilainya
# File .env.local TIDAK boleh di-commit ke repository

# URL base API backend Express
# Development : gunakan '/api' (relative) agar Vite proxy meneruskan ke localhost:3000
#               tanpa kena CORS. JANGAN pakai http://localhost:3000/api langsung.
# Production  : ganti dengan URL penuh backend yang sudah di-deploy
VITE_API_BASE_URL=/api

# ID produk yang ditampilkan di halaman ini
VITE_PRODUCT_ID=1
