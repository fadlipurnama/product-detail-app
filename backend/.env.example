# Application
NODE_ENV=development
PORT=3000

# Docker Compose PostgreSQL
POSTGRES_DB=product_catalog
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Prisma — Node.js backend (running on host)
DATABASE_URL="postgresql://app_user:change-this-local-password@localhost:5432/product_catalog?schema=public"
